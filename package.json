{
	"name": "registry",
	"type": "module",
	"version": "0.2.3",
	"scripts": {
		"dev": "wrangler dev",
		"deploy": "wrangler deploy --minify",
		"cf-typegen": "wrangler types --env-interface CloudflareBindings",
		"format": "biome check --write",
		"registry:build": "shadcn build",
		"build": "npm run registry:build && npm run format",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage"
	},
	"devEngines": {
		"packageManager": {
			"name": "npm"
		}
	},
	"packageManager": "npm@11.8.0",
	"devDependencies": {
		"@biomejs/biome": "^2.4.5",
		"@edge-runtime/vm": "^5.0.0",
		"@types/lodash": "^4.17.23",
		"@vitest/coverage-v8": "^4.0.18",
		"shadcn": "^3.8.4",
		"vitest": "^4.0.18",
		"wrangler": "^4.64.0"
	},
	"dependencies": {
		"lodash": "^4.17.23"
	}
}
